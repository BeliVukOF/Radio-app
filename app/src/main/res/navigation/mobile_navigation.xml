<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_region_selection">

    <fragment
        android:id="@+id/nav_region_selection"
        android:name="com.example.radioapp.ui.region.RegionSelectionFragment"
        android:label="Select Region"
        tools:layout="@layout/fragment_region_selection" />

    <fragment
        android:id="@+id/nav_radio"
        android:name="com.example.radioapp.ui.radio.RadioFragment"
        android:label="Radio">
        <argument
            android:name="region"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/nav_all"
        android:name="com.example.radioapp.ui.radio.RadioFragment"
        android:label="All Stations">
        <argument
            android:name="region"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/nav_favorites"
        android:name="com.example.radioapp.ui.radio.RadioFragment"
        android:label="Favorite Stations">
        <argument
            android:name="isFavorites"
            app:argType="boolean"
            android:defaultValue="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_albania"
        android:name="com.example.radioapp.ui.radio.RadioFragment"
        android:label="Albania">
        <argument
            android:name="region"
            app:argType="string"
            android:defaultValue="Albania" />
    </fragment>

    <fragment
        android:id="@+id/nav_bosnia"
        android:name="com.example.radioapp.ui.radio.RadioFragment"
        android:label="Bosnia">
        <argument
            android:name="region"
            app:argType="string"
            android:defaultValue="Bosnia" />
    </fragment>

    <fragment
        android:id="@+id/nav_bulgaria"
        android:name="com.example.radioapp.ui.radio.RadioFragment"
        android:label="Bulgaria">
        <argument
            android:name="region"
            app:argType="string"
            android:defaultValue="Bulgaria" />
    </fragment>

    <fragment
        android:id="@+id/nav_croatia"
        android:name="com.example.radioapp.ui.radio.RadioFragment"
        android:label="Croatia">
        <argument
            android:name="region"
            app:argType="string"
            android:defaultValue="Croatia" />
    </fragment>

    <fragment
        android:id="@+id/nav_greece"
        android:name="com.example.radioapp.ui.radio.RadioFragment"
        android:label="Greece">
        <argument
            android:name="region"
            app:argType="string"
            android:defaultValue="Greece" />
    </fragment>

    <fragment
        android:id="@+id/nav_macedonia"
        android:name="com.example.radioapp.ui.radio.RadioFragment"
        android:label="Macedonia">
        <argument
            android:name="region"
            app:argType="string"
            android:defaultValue="Macedonia" />
    </fragment>

    <fragment
        android:id="@+id/nav_montenegro"
        android:name="com.example.radioapp.ui.radio.RadioFragment"
        android:label="Montenegro">
        <argument
            android:name="region"
            app:argType="string"
            android:defaultValue="Montenegro" />
    </fragment>

    <fragment
        android:id="@+id/nav_serbia"
        android:name="com.example.radioapp.ui.radio.RadioFragment"
        android:label="Serbia">
        <argument
            android:name="region"
            app:argType="string"
            android:defaultValue="Serbia" />
    </fragment>

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.example.radioapp.ui.settings.SettingsFragment"
        android:label="@string/menu_settings"
        tools:layout="@layout/fragment_settings" />

</navigation>