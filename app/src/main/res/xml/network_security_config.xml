<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext for specific radio station domains that don't support HTTPS yet -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">tdiradio.com</domain>
        <domain includeSubdomains="true">playradio.rs</domain>
        <domain includeSubdomains="true">streaming.rs</domain>
        <domain includeSubdomains="true">radios.rs</domain>
        <domain includeSubdomains="true">radiojat.rs</domain>
        <domain includeSubdomains="true">radiomorava.rs</domain>
        <domain includeSubdomains="true">karolina.rs</domain>
        <domain includeSubdomains="true">coolradio.rs</domain>
        <domain includeSubdomains="true">name.ba</domain>
        <domain includeSubdomains="true">radio-banovina.hr</domain>
        <domain includeSubdomains="true">social3.hr</domain>
        <domain includeSubdomains="true">asurahosting.com</domain>
        <domain includeSubdomains="true">enterzagreb.hr</domain>
        <domain includeSubdomains="true">otvoreni.hr</domain>
        <domain includeSubdomains="true">radio.co</domain>
        <domain includeSubdomains="true">pink.rs</domain>
        <domain includeSubdomains="true">79.106.48.2</domain>
        <domain includeSubdomains="true">sednastream.com</domain>
        <domain includeSubdomains="true">streams.ovh</domain>
        <domain includeSubdomains="true">168.119.74.185</domain>
        <domain includeSubdomains="true">neotel.mk</domain>
        <domain includeSubdomains="true">dreamsiteradiocp.com</domain>
        <domain includeSubdomains="true">ddns.net</domain>
        <domain includeSubdomains="true">176.9.117.123</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
    </domain-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
